# systemd unit: runs the Serpent.io server at boot and restarts it if it stops.
# Installed by online/deploy/deploy.sh (binary in /srv/apps/serpent, behind Caddy on loopback).
[Unit]
Description=Serpent.io online game server
After=network-online.target

[Service]
User=serpent
WorkingDirectory=/srv/apps/serpent
Environment=PORT=8010 BIND=127.0.0.1 BOTS=100 WEB_ROOT=/srv/apps/serpent
ExecStart=/srv/apps/serpent/serpent-server
Restart=always
RestartSec=2
# hardening: the server needs nothing but its port and the page files
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# a small shared box: it uses ~10 MB; never let it take the machine down
MemoryMax=150M
CPUQuota=60%

[Install]
WantedBy=multi-user.target
